 components/cam/src/physics/rrtmg/radiation.F90 | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/components/cam/src/physics/rrtmg/radiation.F90 b/components/cam/src/physics/rrtmg/radiation.F90
index 3828be96e2..f6c2f16063 100644
--- a/components/cam/src/physics/rrtmg/radiation.F90
